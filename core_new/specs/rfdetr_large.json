{
    "name": "rfdetr_large",
    "rel_path": "rfdetr/rfdetr-large.onnx",
    "metadata": {
        "model_family": "RF-DETR",
        "in": "input",
        "out": [
            "dets",
            "labels"
        ]
    },
    "input_type": "image",
    "output_type": "bbox",
    "batch": true,
    "preprocess": [
        {
            "op": "resize",
            "mode": "nearest",
            "size": [
                704,
                704
            ]
        },
        {
            "op": "all_to_gpu"
        },
        {
            "op": "img_to_tensor"
        },
        {
            "op": "normalize",
            "mean": [
                0.485,
                0.456,
                0.406
            ],
            "std": [
                0.229,
                0.224,
                0.225
            ]
        }
    ],
    "postprocess": [
        {
            "op": "accumulate_rfdetr",
            "threshold": 0.5
        }
    ]
}